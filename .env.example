# ============================================================
# SM Sport Center — contoh konfigurasi environment
# Salin ke `.env.local` lalu isi nilainya.
# JANGAN commit `.env.local` ke repository.
# ============================================================

# JWT secret untuk menandatangani session cookie.
# WAJIB: ganti dengan string acak yang kuat (min. 32 karakter) sebelum deploy.
# Jika kosong, aplikasi menolak semua akses (fail-closed) — tidak ada fallback.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Path database SQLite (relatif terhadap folder proyek).
DATABASE_PATH=./data/sm-sport.db
