# ============================================================
# SM Sport Center — .gitignore
# ============================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (jangan commit!)
.env*
!.env.example

# database (SQLite files)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# docs (internal, bukan untuk repo publik)
/docs/

# AI tools — tidak di-commit
AGENTS.md
CLAUDE.md
.agents/
.claude/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
